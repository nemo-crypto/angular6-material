{
  "name": "material-learning-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "tsc -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@angular/core": "21.2.0",
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/forms": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@angular/router": "21.2.0",
    "@angular/material": "21.2.0",
    "@angular/cdk": "21.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.0",
    "@angular/cli": "21.2.0",
    "@angular/compiler-cli": "21.2.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.58.2"
  },
  "description": "Angular 21 + Material tutorial with standalone components, Signals, reactive forms and LocalStorage. Angular 教学 Demo：课程管理、响应式布局与 Playwright 测试。",
  "keywords": [
    "angular",
    "angular-material",
    "typescript",
    "signals",
    "reactive-forms",
    "localstorage",
    "playwright",
    "tutorial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nemo-crypto/angular6-material.git"
  }
}
